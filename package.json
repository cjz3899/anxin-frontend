{
  "name": "anxin-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "安心文档分析 —— 智能合同风险分析助手",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "less"
  },
  "scripts": {
    "dev:weapp": "taro build --type weapp --watch",
    "dev:weapp:local": "cross-env API_BASE_URL=http://localhost:8080 taro build --type weapp --watch",
    "dev:weapp:test": "cross-env API_BASE_URL=https://test-api.anxin.com taro build --type weapp --watch",
    "dev:weapp:prod": "cross-env API_BASE_URL=https://api.anxin.com taro build --type weapp --watch",
    "build:weapp": "taro build --type weapp",
    "build:weapp:test": "cross-env API_BASE_URL=https://test-api.anxin.com taro build --type weapp",
    "build:weapp:prod": "cross-env API_BASE_URL=https://api.anxin.com taro build --type weapp",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --fix",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@nutui/nutui-react-taro": "^3.0.20",
    "@tarojs/components": "4.1.6",
    "@tarojs/helper": "4.1.6",
    "@tarojs/plugin-framework-react": "4.1.6",
    "@tarojs/plugin-platform-weapp": "4.1.6",
    "@tarojs/react": "4.1.6",
    "@tarojs/runtime": "4.1.6",
    "@tarojs/shared": "4.1.6",
    "@tarojs/taro": "4.1.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/preset-react": "^7.24.1",
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@tarojs/cli": "4.1.6",
    "@tarojs/taro-loader": "4.1.6",
    "@tarojs/webpack5-runner": "4.1.6",
    "@types/node": "^20.12.7",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/webpack-env": "^1.18.4",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "autoprefixer": "^10.4.19",
    "babel-preset-taro": "4.1.6",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-taro": "4.1.6",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "husky": "^9.0.11",
    "less": "^4.2.0",
    "lint-staged": "^15.2.2",
    "postcss": "^8.4.38",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "webpack": "5.91.0"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{less,css}": [
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
