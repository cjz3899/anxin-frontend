<view class="container">
  <view class="header">
    <view class="avatar-wrap" bindtap="onChooseAvatar">
      <image class="avatar" src="{{avatar || '/images/default-avatar.png'}}" mode="aspectFill"></image>
      <view class="avatar-edit">编辑</view>
    </view>
    <view class="nickname" bindtap="onEditNickname">
      <text>{{nickname}}</text>
      <text class="edit-icon">✎</text>
    </view>
    <view class="user-id">ID: {{userId}}</view>
  </view>

  <view class="menu-section">
    <view class="menu-item">
      <text class="menu-label">关于我们</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item">
      <text class="menu-label">帮助中心</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item">
      <text class="menu-label">意见反馈</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-item" bindtap="onLogout">
      <text class="menu-label logout-text">退出登录</text>
    </view>
  </view>
</view>
