<view class="container">
  <view class="header">
    <view class="title">安心文档分析</view>
    <view class="subtitle">上传文件，智能识别合同风险</view>
  </view>

  <view class="upload-area" bindtap="onChooseFile">
    <view class="upload-icon">+</view>
    <view class="upload-text" wx:if="{{!uploading}}">上传文件</view>
    <view class="upload-text" wx:else>上传中 {{uploadProgress}}%</view>
    <view class="upload-hint">支持 PDF、Word、图片（≤10MB）</view>
  </view>

  <view class="section-title" wx:if="{{fileList.length > 0}}">历史文件</view>

  <view class="file-list">
    <view class="file-item" wx:for="{{fileList}}" wx:key="id" bindtap="onViewReport" data-taskid="{{item.taskId}}">
      <view class="file-info">
        <view class="file-icon">📄</view>
        <view class="file-detail">
          <view class="file-name">{{item.name}}</view>
          <view class="file-meta">{{item.time}}</view>
        </view>
      </view>
      <view class="file-status {{item.status === 'SUCCESS' ? 'status-success' : 'status-pending'}}">
        {{item.status === 'SUCCESS' ? '已完成' : '分析中'}}
      </view>
    </view>
  </view>

  <view class="empty-hint" wx:if="{{fileList.length === 0 && !uploading}}">
    <text>暂无文件，点击上方上传</text>
  </view>
</view>
