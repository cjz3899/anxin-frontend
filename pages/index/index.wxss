/*index.wxss —— 【临时测试页】*/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}
.scrollarea {
  flex: 1;
  overflow-y: hidden;
}
.container {
  padding: 24rpx;
}
.tips {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}
.btn {
  margin-bottom: 20rpx;
}
.btn.mini {
  font-size: 24rpx;
  padding: 8rpx 24rpx;
}
.log-title {
  font-size: 26rpx;
  color: #333;
  margin: 20rpx 0 12rpx;
}
.log-box {
  height: 50vh;
  background: #111;
  border-radius: 12rpx;
  padding: 16rpx;
}
.log-line {
  font-size: 20rpx;
  color: #0f0;
  word-break: break-all;
  line-height: 1.6;
}
