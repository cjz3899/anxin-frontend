page {
  height: 100vh;
  background: #f3f5f9;
  font-size: 28rpx;
  color: #1f2329;
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.scrollarea {
  flex: 1;
  height: 0;
  padding: 20rpx 24rpx 40rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 35, 41, 0.04);
}

.card-disabled {
  opacity: 0.65;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.card-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.account-head {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.account-avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  flex: none;
}

.account-avatar-empty {
  background: #e8edf7;
  color: #3d7fff;
  font-size: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
}

.account-name {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.account-desc {
  font-size: 24rpx;
  color: #8a919f;
}

.form-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.form-label {
  width: 120rpx;
  flex: none;
  color: #4a5261;
}

.avatar-btn {
  padding: 0;
  margin: 0 20rpx 0 0;
  background: transparent;
  line-height: 1;
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  flex: none;
}

.avatar-btn::after {
  border: none;
}

.avatar-btn[disabled] {
  background: transparent;
}

.avatar-preview {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  display: block;
}

.avatar-preview-empty {
  background: #f0f2f6;
  color: #8a919f;
  font-size: 26rpx;
  border: 2rpx dashed #c9cfda;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.form-side {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.form-tip {
  font-size: 22rpx;
  color: #9aa1ad;
  margin-bottom: 4rpx;
}

.avatar-status {
  font-size: 24rpx;
  margin: -6rpx 0 20rpx 120rpx;
  word-break: break-all;
}

.avatar-status-ok {
  color: #00b578;
}

.avatar-status-err {
  color: #e54545;
}

.nickname-input {
  flex: 1;
  min-width: 0;
  margin-right: 20rpx;
  height: 76rpx;
  background: #f6f7fa;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.action-row {
  margin-top: 16rpx;
}

.btn-primary {
  background: #3d7fff;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  line-height: 88rpx;
  height: 88rpx;
  padding: 0;
  margin: 0;
}

.btn-primary::after {
  border: none;
}

.btn-primary-hover {
  background: #2f6ce6;
}

.btn-primary[disabled] {
  background: #a9c6ff;
  color: #fff;
}

.btn-secondary {
  background: #eef4ff;
  color: #3d7fff;
  border-radius: 44rpx;
  font-size: 28rpx;
  line-height: 80rpx;
  height: 80rpx;
  padding: 0;
  margin: 0;
}

.btn-secondary::after {
  border: none;
}

.btn-secondary[disabled] {
  background: #f0f2f6;
  color: #9aa1ad;
}

.account-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.account-actions .btn-text {
  margin: 0 0 0 40rpx;
}

.btn-text {
  background: transparent;
  color: #8a919f;
  font-size: 26rpx;
  padding: 0;
  margin: 12rpx 0 0 auto;
  width: auto;
  line-height: 1.6;
}

.btn-text::after {
  border: none;
}

.btn-text.small {
  font-size: 24rpx;
  margin: 0;
}

.saved-box {
  margin-top: 24rpx;
  background: #f6f7fa;
  border-radius: 12rpx;
  padding: 20rpx;
}

.saved-title {
  font-size: 24rpx;
  color: #8a919f;
  margin-bottom: 16rpx;
}

.saved-body {
  display: flex;
  align-items: center;
}

.saved-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.saved-nickname {
  font-size: 28rpx;
  word-break: break-all;
}

.log-box {
  height: 420rpx;
  background: #10131a;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
}

.log-line {
  font-size: 21rpx;
  line-height: 1.7;
  word-break: break-all;
  display: flex;
  align-items: flex-start;
}

.log-time {
  color: #5c6472;
  margin-right: 12rpx;
  flex: none;
}

.log-text-ok {
  color: #6fe3a2;
}

.log-text-err {
  color: #ff8f8f;
}

.foot-tip {
  text-align: center;
  font-size: 22rpx;
  color: #9aa1ad;
  margin-top: 8rpx;
}
